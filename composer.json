{
  "name": "jauntin/two-factor-auth",
  "description": "Laravel package for two factor authentication via email",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "jauntin",
    "authentication",
    "two-factor-auth"
  ],
  "authors": [
    {
      "name": "Alex Andreiev",
      "email": "alex@jauntin.com",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/jauntin/two-factor-auth",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0 || ^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.9.3",
    "laravel/pint": "^1.21.2",
    "orchestra/testbench": "^10.1 || ^11.0",
    "phpunit/phpunit": "^11.5.14 || ^12.5.8"
  },
  "autoload": {
    "psr-4": {
      "Jauntin\\TwoFactorAuth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Jauntin\\TwoFactorAuth\\TwoFactorAuthServiceProvider"
      ]
    }
  }
}
